generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  engineType      = "library"
}



datasource db {
  provider = "postgresql"
}



model AthleteItemLog {

  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String? @db.Uuid @map("organization_id")
  workoutItemId String @db.Uuid @map("workout_item_id")
  athleteId      String? @db.Uuid @map("athlete_id")
  loggedAt       DateTime? @default(now()) @db.Timestamptz(6) @map("logged_at")
  setsCompleted  Json? @map("sets_completed")
  rpe             Int?
  notes           String?
  skipped         Boolean?       @default(false)
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  users           User?         @relation(fields: [athleteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workoutitems    WorkoutItem   @relation(fields: [workoutItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("athlete_item_logs")
}

model AthleteWorkoutCompletion {

  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athleteId        String? @db.Uuid @map("athlete_id")
  workoutDayId    String? @db.Uuid @map("workout_day_id")
  organizationId   String? @db.Uuid @map("organization_id")
  completedAt      DateTime? @default(now()) @db.Timestamptz(6) @map("completed_at")
  overallNotes     String? @map("overall_notes")
  completionStatus String? @default("completed") @map("completion_status")
  createdAt        DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  users             User?         @relation(fields: [athleteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workoutdays       WorkoutDay?   @relation(fields: [workoutDayId], references: [id], onUpdate: NoAction)

  @@map("athlete_workout_completions")
}

model AuthSession {

  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @db.Uuid @map("user_id")
  otpCode   String @map("otp_code")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  users      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("authsessions")
}

model AvailabilityException {

  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String? @db.Uuid @map("organization_id")
  consultantId   String @db.Uuid @map("consultant_id")
  exceptionDate  DateTime @db.Date @map("exception_date")
  startTime      DateTime? @db.Time(6) @map("start_time")
  endTime        DateTime? @db.Time(6) @map("end_time")
  isBlocked      Boolean? @default(true) @map("is_blocked")
  reason          String?
  profiles        Profile       @relation(fields: [consultantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("availabilityexceptions")
}

model BillItem {

  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  billId         String @db.Uuid @map("bill_id")
  packageId      String? @db.Uuid @map("package_id")
  amount          Decimal       @default(0) @db.Decimal
  discount        Decimal?      @default(0) @db.Decimal
  taxAmount       Decimal?      @default(0) @db.Decimal @map("tax_amount")
  total           Decimal       @default(0) @db.Decimal
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  bills           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("billitems")
}

model BillPayment {

  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  billId         String @db.Uuid @map("bill_id")
  clientId       String? @db.Uuid @map("client_id")
  amount          Decimal       @db.Decimal
  paymentMethod  String? @map("payment_method")
  transactionId  String? @map("transaction_id")
  recordedBy     String? @db.Uuid @map("recorded_by")
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  bills           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clients         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("billpayments")
}

model Bill {

  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String @db.Uuid @map("organization_id")
  clientId                String @db.Uuid @map("client_id")
  amount                   Decimal        @default(0) @db.Decimal
  discount                 Decimal?       @default(0) @db.Decimal
  taxAmount                Decimal?       @default(0) @db.Decimal @map("tax_amount")
  total                    Decimal        @default(0) @db.Decimal
  status                   String         @default("unpaid")
  referralSourceId       String? @db.Uuid @map("referral_source_id")
  notes                    String?
  includeNotesInInvoice Boolean? @default(false) @map("include_notes_in_invoice")
  discountAuthorizedBy   String? @map("discount_authorized_by")
  billedById             String? @db.Uuid @map("billed_by_id")
  billedByName           String? @map("billed_by_name")
  billingStaffName       String? @map("billing_staff_name")
  transactionId           String? @map("transaction_id")
  paymentMethod           String? @map("payment_method")
  updatedAt               DateTime? @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt               DateTime? @db.Timestamptz(6) @map("deleted_at")
  createdAt               DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  subscriptionId          String? @db.Uuid @map("subscription_id")
  dueDate                 DateTime? @db.Date @map("due_date")
  billitems                BillItem[]
  billpayments             BillPayment[]
  users                    User?         @relation(fields: [billedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clients                  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions            Subscription? @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction)
  refunds                  Refund[]

  @@map("bills")
}

model BulkAssignment {

  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String @db.Uuid @map("organization_id")
  questionnaireId String @db.Uuid @map("questionnaire_id")
  specialistId    String @db.Uuid @map("specialist_id")
  totalClients    Int @default(0) @map("total_clients")
  respondedCount  Int @default(0) @map("responded_count")
  status           String?          @default("active")
  createdAt       DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  organizations    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         Profile         @relation(fields: [specialistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  formResponses   FormResponse[]

  @@map("bulk_assignments")
}

model ClientAssessmentReport {

  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String @db.Uuid @map("organization_id")
  clientId         String @db.Uuid @map("client_id")
  title             String
  testIndex        Int @map("test_index")
  assessmentData   Json @map("assessment_data")
  reportTexts      Json @map("report_texts")
  painData         Json @map("pain_data")
  reassessmentDate String? @map("reassessment_date")
  createdBy        String? @db.Uuid @map("created_by")
  createdAt        DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  clients           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             User?        @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  organizations     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("client_assessment_reports")
}

model ClientGroupMember {

  groupId      String @db.Uuid @map("group_id")
  clientId     String @db.Uuid @map("client_id")
  addedBy      String? @db.Uuid @map("added_by")
  addedAt      DateTime? @default(now()) @db.Timestamptz(6) @map("added_at")
  users         User?        @relation(fields: [addedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clients       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clientGroups ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([groupId, clientId])

  @@map("client_group_members")
}

model ClientGroup {

  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String @db.Uuid @map("organization_id")
  name                 String
  description          String?
  createdBy           String? @db.Uuid @map("created_by")
  createdAt           DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  clientGroupMembers ClientGroupMember[]
  users                User?                 @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, name])

  @@map("client_groups")
}

model ClientSorenessReport {

  reportId                      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("report_id")
  organizationId                String @db.VarChar(50) @map("organization_id")
  clientUhid                    String @db.VarChar(50) @map("client_uhid")
  createdAt                     DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  assignedByStaffId           String @db.Uuid @map("assigned_by_staff_id")
  sorenessData                  Json @map("soreness_data")
  globalClinicalInterpretation String @map("global_clinical_interpretation")

  @@map("client_soreness_reports")
}

model ClientAdminNote {

  clientId  String @id @db.Uuid @map("client_id")
  remarks    String
  updatedBy String? @db.Uuid @map("updated_by")
  updatedAt DateTime? @default(now()) @db.Timestamptz(6) @map("updated_at")
  clients    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User?    @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("clientadminnotes")
}

model ClientDocument {

  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String @db.Uuid @map("client_id")
  organizationId  String @db.Uuid @map("organization_id")
  documentName    String @map("document_name")
  category         String?
  documentType    String? @map("document_type")
  filePath        String @map("file_path")
  uploadedBy      String? @db.Uuid @map("uploaded_by")
  uploadedByRole String? @map("uploaded_by_role")
  notes            String?
  accessLevel     String? @default("Medical_Staff_Only") @map("access_level")
  createdAt       DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  clients          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            User?        @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("clientdocuments")
}

model ClientEntitlement {

  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String @db.Uuid @map("organization_id")
  clientId        String @db.Uuid @map("client_id")
  invoiceId       String? @db.Uuid @map("invoice_id")
  packageId       String? @db.Uuid @map("package_id")
  serviceId       String? @db.Uuid @map("service_id")
  serviceType     String @map("service_type")
  grantedSessions Int @map("granted_sessions")
  sessionsUsed    Int? @default(0) @map("sessions_used")
  status           String?       @default("active")
  billItemId     String? @db.Uuid @map("bill_item_id")
  notes            String?
  createdAt       DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime? @default(now()) @db.Timestamptz(6) @map("updated_at")
  clients          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packages         Package?     @relation(fields: [packageId], references: [id], onUpdate: NoAction)
  services         Service?     @relation(fields: [serviceId], references: [id], onUpdate: NoAction)
  sessions         Session[]

  @@map("cliententitlements")
}

model ClientOrganization {

  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  name            String
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  organizations   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, name])

  @@map("clientorganizations")
}

model Client {

  id                                              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                                 String @db.Uuid @map("organization_id")
  locationId                                     String? @db.Uuid @map("location_id")
  uhid                                            String                      @unique
  registeredOn                                   DateTime? @default(now()) @db.Timestamptz(6) @map("registered_on")
  honorific                                       String?
  firstName                                      String @map("first_name")
  middleName                                     String? @map("middle_name")
  lastName                                       String @map("last_name")
  gender                                          String?
  mobileNo                                       String @map("mobile_no")
  aadhaarNo                                      String? @map("aadhaar_no")
  bloodGroup                                     String? @map("blood_group")
  dob                                             DateTime?                   @db.Date
  age                                             Int?
  email                                           String?
  alternateMobileNo                             String? @map("alternate_mobile_no")
  occupation                                      String?
  sport                                           String?
  athleteType                                    String? @map("athlete_type")
  orgName                                        String? @map("org_name")
  address                                         String?
  locality                                        String?
  pincode                                         String?
  city                                            String?
  district                                        String?
  state                                           String?
  country                                         String?                     @default("India")
  hasInsurance                                   Boolean? @default(false) @map("has_insurance")
  insuranceProvider                              String? @map("insurance_provider")
  insurancePolicyNo                             String? @map("insurance_policy_no")
  insuranceValidity                              DateTime? @db.Date @map("insurance_validity")
  insuranceCoverageAmount                       Decimal? @db.Decimal @map("insurance_coverage_amount")
  isVip                                          Boolean? @default(false) @map("is_vip")
  referralSource                                 String? @map("referral_source")
  referralSourceDetail                          String? @map("referral_source_detail")
  createdBy                                      String? @db.Uuid @map("created_by")
  createdAt                                      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                                      DateTime? @default(now()) @db.Timestamptz(6) @map("updated_at")
  profileId                                      String? @db.Uuid @map("profile_id")
  assignedConsultantId                          String? @db.Uuid @map("assigned_consultant_id")
  primaryScientistId                            String? @db.Uuid @map("primary_scientist_id")
  deletedAt                                      DateTime? @db.Timestamptz(6) @map("deleted_at")
  billpayments                                    BillPayment[]
  bills                                           Bill[]
  clientAssessmentReports                       ClientAssessmentReport[]
  clientGroupMembers                            ClientGroupMember[]
  clientadminnotes                                ClientAdminNote?
  clientdocuments                                 ClientDocument[]
  cliententitlements                              ClientEntitlement[]
  usersClientsAssignedConsultantIdTousers     User?                      @relation("clients_assigned_consultant_idTousers", fields: [assignedConsultantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersClientsCreatedByTousers                 User?                      @relation("clients_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations                                       Location?                  @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations                                   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profilesClientsPrimaryScientistIdToprofiles Profile?                   @relation("clients_primary_scientist_idToprofiles", fields: [primaryScientistId], references: [id], onUpdate: NoAction)
  profilesClientsProfileIdToprofiles           Profile?                   @relation("clients_profile_idToprofiles", fields: [profileId], references: [id], onUpdate: NoAction)
  enquiries                                       Enquiry[]
  externalTrainingSummary                       ExternalTrainingSummary[]
  formResponses                                  FormResponse[]
  groupAttendance                                GroupAttendance[]
  injuries                                        Injury[]
  performanceAssessments                         PerformanceAssessment[]
  refunds                                         Refund[]
  scientificResources                            ScientificResource[]
  sessions                                        Session[]
  subscriptions                                   Subscription[]
  waitlist                                        Waitlist[]

  @@map("clients")
}

model ConsultantService {

  organizationId String @db.Uuid @map("organization_id")
  consultantId   String @db.Uuid @map("consultant_id")
  serviceId      String @db.Uuid @map("service_id")
  profiles        Profile      @relation(fields: [consultantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([consultantId, serviceId])

  @@map("consultant_services")
}

model ConsultantAvailability {

  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String? @db.Uuid @map("organization_id")
  consultantId          String @db.Uuid @map("consultant_id")
  dayOfWeek            Int @map("day_of_week")
  startTime             DateTime @db.Time(6) @map("start_time")
  endTime               DateTime @db.Time(6) @map("end_time")
  slotDurationInterval Int? @default(30) @map("slot_duration_interval")
  bufferTime            Int? @default(0) @map("buffer_time")
  profiles               Profile       @relation(fields: [consultantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations          Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([consultantId, dayOfWeek])

  @@map("consultantavailability")
}

model EmergencyAlert {

  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  staffId        String @db.Uuid @map("staff_id")
  status          String?       @default("unresolved")
  reason          String?
  latitude        Decimal?      @db.Decimal
  longitude       Decimal?      @db.Decimal
  createdAt      DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  organizations   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles        Profile      @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("emergency_alerts")
}

model Enquiry {

  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String @db.Uuid @map("organization_id")
  firstName          String @map("first_name")
  lastName           String? @map("last_name")
  mobileNo           String @map("mobile_no")
  email               String?
  lookingFor         String? @map("looking_for")
  preferredCallTime String? @map("preferred_call_time")
  referralSource     String? @map("referral_source")
  referralDetails    String? @map("referral_details")
  workPlace          String? @map("work_place")
  notes               String?
  status              String?               @default("pending")
  linkedClientId    String? @db.Uuid @map("linked_client_id")
  createdAt          DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  nextFollowUpAt   DateTime? @db.Timestamptz(6) @map("next_follow_up_at")
  lastInteractionAt DateTime? @db.Timestamptz(6) @map("last_interaction_at")
  clients             Client?              @relation(fields: [linkedClientId], references: [id], onUpdate: NoAction)
  organizations       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enquiryinteractions EnquiryInteraction[]

  @@map("enquiries")
}

model EnquiryInteraction {

  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId         String @db.Uuid @map("enquiry_id")
  interactionType   String @map("interaction_type")
  responseText      String? @map("response_text")
  createdBy         String? @db.Uuid @map("created_by")
  createdAt         DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  followUpRequired Boolean? @default(false) @map("follow_up_required")
  followUpAt       DateTime? @db.Timestamptz(6) @map("follow_up_at")
  users              User?    @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enquiries          Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("enquiryinteractions")
}

model ExcelDiagnosticReport {

  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String @db.Uuid @map("organization_id")
  clientUhid             String? @map("client_uhid")
  patientName            String @map("patient_name")
  dob                     DateTime?     @db.Date
  testHistory            Json @map("test_history")
  latestMetrics          Json @map("latest_metrics")
  clinicalInterpretation String? @map("clinical_interpretation")
  createdBy              String? @db.Uuid @map("created_by")
  createdAt              DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  users                   User?        @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  organizations           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("excel_diagnostic_reports")
}

model Exercise {

  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String? @db.Uuid @map("organization_id")
  name               String
  category           String?
  createdAt         DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  description        String?
  equipmentType     String? @map("equipment_type")
  difficultyLevel   String? @map("difficulty_level")
  muscleGroups      String[] @map("muscle_groups")
  bodyRegion        String? @map("body_region")
  equipmentRequired String? @map("equipment_required")
  instructions       String?
  videoUrl          String? @map("video_url")
  isRehabilitation  Boolean? @default(false) @map("is_rehabilitation")
  isActive          Boolean? @default(true) @map("is_active")
  updatedAt         DateTime? @default(now()) @db.Timestamptz(6) @map("updated_at")
  organizations      Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  liftitems          LiftItem[]
  maxPrRecords     MaxPrRecord[]

  @@unique([organizationId, name])

  @@map("exercises")
}

model ExternalTrainingSummary {

  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String @db.Uuid @map("organization_id")
  clientId         String @db.Uuid @map("client_id")
  externalSystem   String @default("TeamBuildr") @map("external_system")
  trainingDate     DateTime @db.Date @map("training_date")
  workoutName      String? @map("workout_name")
  durationMinutes  Int? @map("duration_minutes")
  trainingLoad     Decimal? @db.Decimal @map("training_load")
  completionStatus String? @map("completion_status")
  createdAt        DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
