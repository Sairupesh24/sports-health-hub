  cancellationReason                      String?              @map("cancellation_reason")
  isUnentitled                            Boolean?             @default(false) @map("is_unentitled")
  createdBy                               String?              @map("created_by") @db.Uuid
  createdAt                               DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                               DateTime?            @default(now()) @map("updated_at") @db.Timestamptz(6)
  preferenceType                          String?              @default("Strict") @map("preference_type")
  isFlexibleRouting                       Boolean?             @default(false) @map("is_flexible_routing")
  groupName                               String?              @map("group_name")
  sessionLocation                         String?              @map("session_location")
  sessionNotes                            String?              @map("session_notes")
  attachments                             Json?                @default("[]")
  sessionTypeId                           String?              @map("session_type_id") @db.Uuid
  groupAttendance                         GroupAttendance[]
  physiosessiondetails                    PhysioSessionDetail?
  clients                                 Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                   User?                @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cliententitlements                      ClientEntitlement?   @relation(fields: [entitlementId], references: [id], onUpdate: NoAction)
  organizations                           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profilesSessionsScientistIdToprofiles   Profile?             @relation("sessions_scientist_idToprofiles", fields: [scientistId], references: [id], onUpdate: NoAction)
  servicesSessionsServiceIdToservices     Service?             @relation("sessions_service_idToservices", fields: [serviceId], references: [id], onUpdate: NoAction)
  servicesSessionsSessionTypeIdToservices Service?             @relation("sessions_session_type_idToservices", fields: [sessionTypeId], references: [id], onUpdate: NoAction)
  profilesSessionsTherapistIdToprofiles   Profile?             @relation("sessions_therapist_idToprofiles", fields: [therapistId], references: [id], onUpdate: NoAction)

  @@map("sessions")
}

