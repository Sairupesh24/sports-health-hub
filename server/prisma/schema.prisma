model planner_work_items {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id            String?                @db.Uuid
  workstream_id         String?                @db.Uuid
  parent_id             String?                @db.Uuid
  title                 String
  description           String?
  status                String?                @default("planned")
  priority              String?                @default("medium")
  assignee_id           String?                @db.Uuid
  creator_id            String?                @db.Uuid
  sprint_id             String?                @db.Uuid
  start_date            DateTime?              @db.Date
  due_date              DateTime?              @db.Date
  estimated_hours       Decimal?               @default(0.00) @db.Decimal(8, 2)
  actual_hours          Decimal?               @default(0.00) @db.Decimal(8, 2)
  is_milestone          Boolean?               @default(false)
  is_critical           Boolean?               @default(false)
  sort_order            Int?                   @default(0)
  created_at            DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?              @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?              @db.Timestamptz(6)
  planner_projects      planner_projects?      @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planner_workstreams   planner_workstreams?   @relation(fields: [workstream_id], references: [id], onUpdate: NoAction)
  parent                planner_work_items?    @relation("WorkItemHierarchy", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children              planner_work_items[]   @relation("WorkItemHierarchy")
}

