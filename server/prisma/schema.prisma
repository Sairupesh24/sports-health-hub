generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model athlete_item_logs {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?        @db.Uuid
  workout_item_id String         @db.Uuid
  athlete_id      String?        @db.Uuid
  logged_at       DateTime?      @default(now()) @db.Timestamptz(6)
  sets_completed  Json?
  rpe             Int?
  notes           String?
  skipped         Boolean?       @default(false)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  users           users?         @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workoutitems    workoutitems   @relation(fields: [workout_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model athlete_workout_completions {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  athlete_id        String?        @db.Uuid
  workout_day_id    String?        @db.Uuid
  organization_id   String?        @db.Uuid
  completed_at      DateTime?      @default(now()) @db.Timestamptz(6)
  overall_notes     String?
  completion_status String?        @default("completed")
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  users             users?         @relation(fields: [athlete_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations     organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workoutdays       workoutdays?   @relation(fields: [workout_day_id], references: [id], onUpdate: NoAction)
}

model authsessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  otp_code   String
  expires_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model availabilityexceptions {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String?        @db.Uuid
  consultant_id   String         @db.Uuid
  exception_date  DateTime       @db.Date
  start_time      DateTime?      @db.Time(6)
  end_time        DateTime?      @db.Time(6)
  is_blocked      Boolean?       @default(true)
  reason          String?
  profiles        profiles       @relation(fields: [consultant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model billitems {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  bill_id         String        @db.Uuid
  package_id      String?       @db.Uuid
  amount          Decimal       @default(0) @db.Decimal
  discount        Decimal?      @default(0) @db.Decimal
  total           Decimal       @default(0) @db.Decimal
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  tax_amount      Decimal?      @default(0) @db.Decimal
  bills           bills         @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model billpayments {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  bill_id         String        @db.Uuid
  client_id       String?       @db.Uuid
  amount          Decimal       @db.Decimal
  payment_method  String?
  transaction_id  String?
  recorded_by     String?       @db.Uuid
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  bills           bills         @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clients         clients?      @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model bills {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id          String         @db.Uuid
  client_id                String         @db.Uuid
  amount                   Decimal        @default(0) @db.Decimal
  discount                 Decimal?       @default(0) @db.Decimal
  total                    Decimal        @default(0) @db.Decimal
  status                   String         @default("unpaid")
  referral_source_id       String?        @db.Uuid
  notes                    String?
  include_notes_in_invoice Boolean?       @default(false)
  discount_authorized_by   String?
  billed_by_id             String?        @db.Uuid
  billed_by_name           String?
  billing_staff_name       String?
  transaction_id           String?
  payment_method           String?
  updated_at               DateTime?      @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime?      @db.Timestamptz(6)
  created_at               DateTime?      @default(now()) @db.Timestamptz(6)
  subscription_id          String?        @db.Uuid
  due_date                 DateTime?      @db.Date
  tax_amount               Decimal?       @default(0) @db.Decimal
  billitems                billitems[]
  billpayments             billpayments[]
  users                    users?         @relation(fields: [billed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clients                  clients        @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations            organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions            subscriptions? @relation(fields: [subscription_id], references: [id], onUpdate: NoAction)
  refunds                  refunds[]
}

model bulk_assignments {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String           @db.Uuid
  questionnaire_id String           @db.Uuid
  specialist_id    String           @db.Uuid
  total_clients    Int              @default(0)
  responded_count  Int              @default(0)
  status           String?          @default("active")
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  organizations    organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles         @relation(fields: [specialist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form_responses   form_responses[]
}

model client_assessment_reports {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String        @db.Uuid
  client_id         String        @db.Uuid
  title             String
  test_index        Int
  assessment_data   Json
  report_texts      Json
  pain_data         Json
  reassessment_date String?
  created_by        String?       @db.Uuid
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  clients           clients       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users?        @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organizations     organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model client_group_members {
  group_id      String        @db.Uuid
  client_id     String        @db.Uuid
  added_by      String?       @db.Uuid
  added_at      DateTime?     @default(now()) @db.Timestamptz(6)
  users         users?        @relation(fields: [added_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clients       clients       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client_groups client_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, client_id])
}

model client_groups {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String                 @db.Uuid
  name                 String
  description          String?
  created_by           String?                @db.Uuid
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  client_group_members client_group_members[]
  users                users?                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model clientadminnotes {
  client_id  String    @id @db.Uuid
  remarks    String
  updated_by String?   @db.Uuid
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  clients    clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model clientdocuments {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id        String        @db.Uuid
  organization_id  String        @db.Uuid
  document_name    String
  category         String?
  document_type    String?
  file_path        String
  uploaded_by      String?       @db.Uuid
  uploaded_by_role String?
  notes            String?
  access_level     String?       @default("Medical_Staff_Only")
  created_at       DateTime?     @default(now()) @db.Timestamptz(6)
  clients          clients       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?        @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model client_field_config {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  field_name      String
  is_mandatory    Boolean       @default(false)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, field_name])
}

model cliententitlements {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String        @db.Uuid
  client_id        String        @db.Uuid
  invoice_id       String?       @db.Uuid
  package_id       String?       @db.Uuid
  service_id       String?       @db.Uuid
  service_type     String
  granted_sessions Int
  sessions_used    Int?          @default(0)
  status           String?       @default("active")
  bill_item_id     String?       @db.Uuid
  notes            String?
  created_at       DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @db.Timestamptz(6)
  clients          clients       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations    organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packages         packages?     @relation(fields: [package_id], references: [id], onUpdate: NoAction)
  services         services?     @relation(fields: [service_id], references: [id], onUpdate: NoAction)
  sessions         sessions[]
}

model clientorganizations {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  name            String
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model clients {
  id                                              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                 String                      @db.Uuid
  location_id                                     String?                     @db.Uuid
  uhid                                            String                      @unique
  registered_on                                   DateTime?                   @default(now()) @db.Timestamptz(6)
  honorific                                       String?
  first_name                                      String
  middle_name                                     String?
  last_name                                       String
  gender                                          String?
  mobile_no                                       String
  aadhaar_no                                      String?
  blood_group                                     String?
  dob                                             DateTime?                   @db.Date
  age                                             Int?
  email                                           String?
  alternate_mobile_no                             String?
  occupation                                      String?
  sport                                           String?
  athlete_type                                    String?
  org_name                                        String?
  address                                         String?
  locality                                        String?
  pincode                                         String?
  city                                            String?
  district                                        String?
  state                                           String?
  country                                         String?                     @default("India")
  has_insurance                                   Boolean?                    @default(false)
  insurance_provider                              String?
  insurance_policy_no                             String?
  insurance_validity                              DateTime?                   @db.Date
  insurance_coverage_amount                       Decimal?                    @db.Decimal
  is_vip                                          Boolean?                    @default(false)
  referral_source                                 String?
  referral_source_detail                          String?
  assigned_consultant_id                          String?                     @db.Uuid
  created_by                                      String?                     @db.Uuid
  created_at                                      DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime?                   @default(now()) @db.Timestamptz(6)
  profile_id                                      String?                     @db.Uuid
  primary_scientist_id                            String?                     @db.Uuid
  deleted_at                                      DateTime?                   @db.Timestamptz(6)
  billpayments                                    billpayments[]
  bills                                           bills[]
  client_assessment_reports                       client_assessment_reports[]
  client_group_members                            client_group_members[]
  clientadminnotes                                clientadminnotes?
  clientdocuments                                 clientdocuments[]
  cliententitlements                              cliententitlements[]
  users_clients_assigned_consultant_idTousers     users?                      @relation("clients_assigned_consultant_idTousers", fields: [assigned_consultant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_clients_created_byTousers                 users?                      @relation("clients_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations                                       locations?                  @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations                                   organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_clients_primary_scientist_idToprofiles profiles?                   @relation("clients_primary_scientist_idToprofiles", fields: [primary_scientist_id], references: [id], onUpdate: NoAction)
  profiles_clients_profile_idToprofiles           profiles?                   @relation("clients_profile_idToprofiles", fields: [profile_id], references: [id], onUpdate: NoAction)
  enquiries                                       enquiries[]
  external_training_summary                       external_training_summary[]
  form_responses                                  form_responses[]
  group_attendance                                group_attendance[]
  injuries                                        injuries[]
  performance_assessments                         performance_assessments[]
  refunds                                         refunds[]
  scientific_resources                            scientific_resources[]
  sessions                                        sessions[]
  subscriptions                                   subscriptions[]
  waitlist                                        waitlist[]
}

model consultant_services {
  organization_id String        @db.Uuid
  consultant_id   String        @db.Uuid
  service_id      String        @db.Uuid
  profiles        profiles      @relation(fields: [consultant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services        services      @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([consultant_id, service_id])
}

model consultantavailability {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String?        @db.Uuid
  consultant_id          String         @db.Uuid
  day_of_week            Int
  start_time             DateTime       @db.Time(6)
  end_time               DateTime       @db.Time(6)
  slot_duration_interval Int?           @default(30)
  buffer_time            Int?           @default(0)
  profiles               profiles       @relation(fields: [consultant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations          organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([consultant_id, day_of_week])
}

model emergency_alerts {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  staff_id        String        @db.Uuid
  status          String?       @default("unresolved")
  reason          String?
  latitude        Decimal?      @db.Decimal
  longitude       Decimal?      @db.Decimal
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  admin_decision  String?
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles        profiles      @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model enquiries {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String                @db.Uuid
  first_name          String
  last_name           String?
  mobile_no           String
  email               String?
  looking_for         String?
  preferred_call_time String?
  referral_source     String?
  referral_details    String?
  work_place          String?
  notes               String?
  status              String?               @default("pending")
  linked_client_id    String?               @db.Uuid
  next_follow_up_at   DateTime?             @db.Timestamptz(6)
  last_interaction_at DateTime?             @db.Timestamptz(6)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  clients             clients?              @relation(fields: [linked_client_id], references: [id], onUpdate: NoAction)
  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enquiryinteractions enquiryinteractions[]
  sessions            sessions[]
}

model enquiryinteractions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id         String    @db.Uuid
  interaction_type   String
  response_text      String?
  follow_up_required Boolean?  @default(false)
  follow_up_at       DateTime? @db.Timestamptz(6)
  created_by         String?   @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  users              users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enquiries          enquiries @relation(fields: [enquiry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model excel_diagnostic_reports {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String        @db.Uuid
  client_uhid             String?
  patient_name            String
  dob                     DateTime?     @db.Date
  test_history            Json
  latest_metrics          Json
  clinical_interpretation String?
  created_by              String?       @db.Uuid
  created_at              DateTime?     @default(now()) @db.Timestamptz(6)
  users                   users?        @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organizations           organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exercises {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String?          @db.Uuid
  name               String
  description        String?
  category           String?
  equipment_type     String?
  difficulty_level   String?
  muscle_groups      String[]
  body_region        String?
  equipment_required String?
  instructions       String?
  video_url          String?
  is_rehabilitation  Boolean?         @default(false)
  is_active          Boolean?         @default(true)
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?        @default(now()) @db.Timestamptz(6)
  organizations      organizations?   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  liftitems          liftitems[]
  max_pr_records     max_pr_records[]

  @@unique([organization_id, name])
}

model external_training_summary {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String        @db.Uuid
  client_id         String        @db.Uuid
  external_system   String        @default("TeamBuildr")
  training_date     DateTime      @db.Date
  workout_name      String?
  duration_minutes  Int?
  training_load     Decimal?      @db.Decimal
  completion_status String?
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @db.Timestamptz(6)
  clients           clients       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations     organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id, training_date(sort: Desc)], map: "idx_ext_training_client_date")
}

model form_responses {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String            @db.Uuid
  form_id                 String            @db.Uuid
  client_id               String            @db.Uuid
  specialist_id           String?           @db.Uuid
  bulk_assignment_id      String?           @db.Uuid
  status                  String?           @default("pending")
  response_data           Json?
  clinical_interpretation String?
  submitted_at            DateTime?         @db.Timestamptz(6)
  created_at              DateTime?         @default(now()) @db.Timestamptz(6)
  bulk_assignments        bulk_assignments? @relation(fields: [bulk_assignment_id], references: [id], onUpdate: NoAction)
  clients                 clients           @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations           organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles                profiles?         @relation(fields: [specialist_id], references: [id], onUpdate: NoAction)
}

model group_attendance {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String    @db.Uuid
  client_id         String    @db.Uuid
  attendance_status String    @default("Present")
  notes             String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  clients           clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions          sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, client_id])
}

model hr_employees {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String        @db.Uuid
  profile_id              String        @unique @db.Uuid
  job_id                  String?       @db.Uuid
  date_of_joining         DateTime?     @db.Date
  employment_type         String?
  bank_name               String?
  bank_account_no         String?
  ifsc_code               String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  created_at              DateTime?     @default(now()) @db.Timestamptz(6)
  hr_jobs                 hr_jobs?      @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  organizations           organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles                profiles      @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model hr_jobs {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String         @db.Uuid
  name            String
  description     String?
  is_active       Boolean?       @default(true)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  hr_employees    hr_employees[]
  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model hrattendancelogs {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String        @db.Uuid
  profile_id           String        @db.Uuid
  type                 String
  latitude             Decimal?      @db.Decimal
  longitude            Decimal?      @db.Decimal
